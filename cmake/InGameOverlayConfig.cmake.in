@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(NOT TARGET Nemirtingas::MiniDetour)
  find_dependency(MiniDetour CONFIG)
endif()
if(@INGAMEOVERLAY_USE_SPDLOG@ AND NOT TARGET spdlog::spdlog_header_only)
  find_dependency(spdlog CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/InGameOverlayTargets.cmake")
check_required_components(InGameOverlay)
